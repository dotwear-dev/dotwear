{
  "name": "@dotwear/react-native-icons",
  "version": "0.2.1",
  "description": "Pixel-perfect pixel-art icons for React Native (crisp on fractional screen densities)",
  "keywords": [
    "icons",
    "pixel",
    "pixel-art",
    "react-native",
    "design-system"
  ],
  "license": "MIT",
  "homepage": "https://dotwear.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotwear-dev/dotwear.git",
    "directory": "packages/react-native-icons"
  },
  "bugs": {
    "url": "https://github.com/dotwear-dev/dotwear/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@dotwear/icons": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "test-renderer": "^1.3.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
