{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dotwear/icon.schema.json",
  "title": "Pixel icon source",
  "type": "object",
  "required": ["name", "category", "tier", "sizes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case。フォルダ名と一致させる"
    },
    "category": { "type": "string" },
    "tier": { "enum": ["free", "pro"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sizes": {
      "type": "object",
      "required": ["16"],
      "additionalProperties": false,
      "properties": {
        "12": { "$ref": "#/$defs/grid12" },
        "16": { "$ref": "#/$defs/grid16" },
        "24": { "$ref": "#/$defs/grid24" }
      }
    }
  },
  "$defs": {
    "grid12": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "type": "string", "pattern": "^[.#2-9]{12}$" }
    },
    "grid16": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": { "type": "string", "pattern": "^[.#2-9]{16}$" }
    },
    "grid24": {
      "type": "array", "minItems": 24, "maxItems": 24,
      "items": { "type": "string", "pattern": "^[.#2-9]{24}$" }
    }
  }
}
