---
// 存在しない URL のページ。Cloudflare はビルド結果の 404.html を、見つからないときに返す
import { DotwearIcon, dwSearch } from "@dotwear/web";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <article class="prose">
    <h1>Page not found</h1>
    <p class="not-found-icon" aria-hidden="true"><DotwearIcon icon={dwSearch} scale={4} /></p>
    <p>The page you are looking for doesn't exist or has moved.</p>
    <p><a href="/">Go to the introduction</a> or <a href="/icons/">browse the icons</a>.</p>
  </article>
</Base>
