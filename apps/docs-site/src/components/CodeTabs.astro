---
// プラットフォームごとのコード例をタブで切り替える（Web / SwiftUI。Android は後から同じ形で足す）。
// - 選んだプラットフォームは、ページ内のすべてのタブとほかのページにも引き継ぐ（localStorage）
// - JavaScript が動かないときは、タブを出さずに全部のパネルを見出し付きで並べる
// - キーボード操作は WAI-ARIA の Tabs パターン（左右の矢印・Home・End）
// コードの色は global.css の --astro-code-* で 4 階調にする（色相のある配色を使わない。ADR-027）
import { Code } from "astro:components";

export type Platform = "web" | "swift";

export interface TabItem {
  platform: Platform;
  /** コード。src/lib/snippets.ts の web() / swift() で取り出したもの、またはコマンドなどの文字列 */
  code?: string;
  lang?: "tsx" | "swift" | "sh" | "css" | "json";
  /** コードの代わり、またはコードの前に出す短い説明（「準備中」など） */
  note?: string;
}

interface Props {
  items: TabItem[];
  /** 読み上げ用の名前（例：「Install」） */
  label: string;
}

const LABELS: Record<Platform, string> = { web: "Web (React)", swift: "iOS (SwiftUI)" };
const DEFAULT_LANG: Record<Platform, TabItem["lang"]> = { web: "tsx", swift: "swift" };

const { items, label } = Astro.props;
// 同じページに複数のタブがあるので、id が重複しないように連番を付ける
const uid = `tabs-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="code-tabs" data-code-tabs>
  <div class="code-tabs-list" role="tablist" aria-label={label} hidden>
    {
      items.map((item, i) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${item.platform}`}
          aria-controls={`${uid}-panel-${item.platform}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-platform={item.platform}
        >
          {LABELS[item.platform]}
        </button>
      ))
    }
  </div>
  {
    items.map((item) => (
      <div
        class="code-tabs-panel"
        role="tabpanel"
        id={`${uid}-panel-${item.platform}`}
        aria-labelledby={`${uid}-tab-${item.platform}`}
        data-platform={item.platform}
      >
        <p class="code-tabs-fallback-title">{LABELS[item.platform]}</p>
        {item.note && <p class="code-tabs-note">{item.note}</p>}
        {item.code && <Code code={item.code} lang={item.lang ?? DEFAULT_LANG[item.platform]} theme="css-variables" />}
      </div>
    ))
  }
</div>

<script>
  const KEY = "dotwear-docs-platform";

  function readSaved(): string | null {
    // プライベートブラウズなどで localStorage が使えないときは、保存なしで動かす
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function select(group: HTMLElement, platform: string, focus = false) {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (!tabs.some((t) => t.dataset.platform === platform)) return;
    for (const tab of tabs) {
      const on = tab.dataset.platform === platform;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    }
    for (const panel of group.querySelectorAll<HTMLElement>('[role="tabpanel"]')) {
      panel.hidden = panel.dataset.platform !== platform;
    }
  }

  function selectEverywhere(platform: string) {
    for (const g of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) select(g, platform);
    try {
      localStorage.setItem(KEY, platform);
    } catch {
      /* 保存できなくても切り替えは効く */
    }
  }

  for (const group of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
    group.classList.add("is-enhanced");
    group.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    select(group, readSaved() ?? tabs[0]!.dataset.platform!);

    for (const tab of tabs) {
      tab.addEventListener("click", () => selectEverywhere(tab.dataset.platform!));
      tab.addEventListener("keydown", (e) => {
        const i = tabs.indexOf(tab);
        const next =
          e.key === "ArrowRight" ? tabs[(i + 1) % tabs.length]
          : e.key === "ArrowLeft" ? tabs[(i - 1 + tabs.length) % tabs.length]
          : e.key === "Home" ? tabs[0]
          : e.key === "End" ? tabs[tabs.length - 1]
          : undefined;
        if (!next) return;
        e.preventDefault();
        selectEverywhere(next.dataset.platform!);
        select(group, next.dataset.platform!, true);
      });
    }
  }
</script>
