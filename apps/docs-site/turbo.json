{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/brand/**",
        "$TURBO_ROOT$/tokens/**",
        "$TURBO_ROOT$/packages/swift/Tests/DocSnippetsTests/**",
        "$TURBO_ROOT$/apps/demo-react-native/doc-snippets/**",
        "$TURBO_ROOT$/apps/demo-flutter/doc_snippets/**"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "PUBLIC_DOTWEAR_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ]
    }
  }
}
