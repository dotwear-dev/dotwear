{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "$TURBO_ROOT$/icons/**", "$TURBO_ROOT$/brand/**", "$TURBO_ROOT$/tokens/**", "$TURBO_ROOT$/schema/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
